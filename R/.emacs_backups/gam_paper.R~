plot_boolean_overlap_distribution <- function(
  data,
  pairs_list,             # list of boolean pairs: list(morpheme = c("morph_ini","morph_fin"), syllable = c("syl_ini","syl_fin"))
  token_var = "token",
  file_svg = "boolean_overlap_distribution.svg"
) {

  # Check columns
  for (pair_name in names(pairs_list)) {
    ini_var <- pairs_list[[pair_name]][1]
    fin_var <- pairs_list[[pair_name]][2]
    if (is.na(match(ini_var, names(data)))) stop(paste("Column", ini_var, "not found"))
    if (is.na(match(fin_var, names(data)))) stop(paste("Column", fin_var, "not found"))
  }
  if (is.na(match(token_var, names(data)))) stop(paste("Column", token_var, "not found"))

  all_df <- data.frame()

  # Loop over all pairs
  for (pair_name in names(pairs_list)) {
    ini_var <- pairs_list[[pair_name]][1]
    fin_var <- pairs_list[[pair_name]][2]

    # Unique tokens
    uniq_tokens <- unique(data[[token_var]])

    # Summary per token
    token_summary <- data.frame(token = uniq_tokens)
    token_summary$ini <- sapply(uniq_tokens, function(t) any(data[[ini_var]][data[[token_var]] == t] == 1))
    token_summary$fin <- sapply(uniq_tokens, function(t) any(data[[fin_var]][data[[token_var]] == t] == 1))

    # Categorize each token
    token_summary$category <- with(token_summary,
                                   ifelse(ini & fin, "both",
                                   ifelse(ini, "ini only",
                                   ifelse(fin, "fin only", "none"))))

    # Count per category
    counts <- table(token_summary$category)
    df_plot <- data.frame(
      category = names(counts),
      n = as.numeric(counts),
      pair = pair_name
    )
    # Set stacking order: ini -> both -> fin -> none
    df_plot$category <- factor(df_plot$category,
                               ##levels = c("ini only", "both", "fin only", "none"))
                               levels = c("none", "fin only", "both", "ini only"))

    all_df <- rbind(all_df, df_plot)
  }

  # Plot all pairs together
  svg(file_svg, width = 8, height = 5)
  p <- ggplot(all_df, aes(x = "", y = n, fill = category)) +
    geom_col() +
    geom_text(aes(label = n), position = position_stack(vjust = 0.5)) +
    facet_wrap(~ pair, scales = "free_x") +
    scale_y_continuous(expand = expansion(mult = c(0, 0.05))) +
    scale_fill_manual(values = c("ini only" = "#1f77b4",
                                 "both" = "#ff7f0e",
                                 "fin only" = "#2ca02c",
                                 "none" = "grey95")) +
    labs(x = NULL, y = "Number of trajectories", fill = "Category",
         ##title = "Distribution of boolean factors over tokens") +
         title = "") +
    theme_minimal() +
    theme(axis.text.x = element_blank(),
  legend.text = element_text(size = 14),
  ##legend.title = element_text(size = 16),
  legend.title = element_blank(),
  strip.text = element_text(size = 16),
  axis.title.y = element_text(size = 16))

  print(p)
  dev.off()

  invisible(all_df)
}

