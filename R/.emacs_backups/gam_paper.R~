plot_cat_distribution <- function(data,
                                  cat_var = "cat",
                                  token_var = "token",
                                  filename = "cat_distribution.svg") {

  # keep one row per token
  unique_tokens <- data[!duplicated(data[[token_var]]),
                        c(token_var, cat_var)]

  counts <- table(unique_tokens[[cat_var]])

  df <- data.frame(
    level = names(counts),
    n = as.numeric(counts)
  )

  df$percent <- df$n / sum(df$n)
  df$label <- paste0(df$n, " (",
                     sprintf("%.1f", df$percent * 100),
                     "%)")

  p <- ggplot(df, aes(x = reorder(level, -n), y = n)) +
    geom_col() +
    geom_text(aes(label = label),
              vjust = -0.3) +
    scale_y_continuous(expand = expansion(mult = c(0, .1))) +
    labs(x = cat_var,
         y = "Number of trajectories",
         ##title = paste("Distribution of", cat_var)) +
         title = "") +
    theme_minimal() +
    theme(
    axis.text.x = element_text(size = 16),
    axis.title.y = element_text(size = 16))

  svg(filename, width = 8, height = 5)
  print(p)
  dev.off()
}



