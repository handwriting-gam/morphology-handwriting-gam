plot_concurvity <- function(
  model,
  file_png,
  which = c("estimate", "worst", "observed"),
  drop_parametric = TRUE,
  width = 10,
  height = 8,
  show_values = TRUE
) {
  stopifnot(inherits(model, "gam"))

  which <- match.arg(which)
  cv <- mgcv::concurvity(model, full = FALSE)

  if (!which %in% names(cv)) stop("Requested concurvity matrix not found: ", which)
  Cmat <- cv[[which]]

  if (drop_parametric) {
    keep <- grepl("^s\\(", rownames(Cmat))
    Cmat <- Cmat[keep, keep, drop = FALSE]
  }

  diag(Cmat) <- NA_real_

  file_out <- sub(
    paste0("\\.", tools::file_ext(file_png), "$"),
    paste0("_", which, ".", tools::file_ext(file_png)),
    file_png
  )

  cor_melt <- reshape2::melt(Cmat)
  colnames(cor_melt) <- c("Term1", "Term2", "Concurvity")

  p <- ggplot2::ggplot(
    cor_melt,
    ggplot2::aes(Term1, Term2, fill = Concurvity)
  ) +
    ggplot2::geom_tile() +
    ggplot2::scale_fill_gradient(low = "white", high = "red", limits = c(0, 1), na.value = "white") +
    ggplot2::theme_minimal() +
    ggplot2::theme(
      axis.text.x = ggplot2::element_text(angle = 45, hjust = 1),
      panel.grid = ggplot2::element_blank()
    ) +
    ggplot2::labs(
      title = paste("Pairwise concurvity of GAM smooths (", which, ")", sep = ""),
      fill = "Concurvity"
    )

  if (show_values) {
    p <- p + ggplot2::geom_text(
      ggplot2::aes(label = ifelse(is.na(Concurvity), "", sprintf("%.1f%%", Concurvity*100))),
      color = "black",
      size = 3
    )
  }

  ggplot2::ggsave(file_out, plot = p, width = width, height = height)

  invisible(Cmat)
}

export_concurvity_latex_split <- function(
  model,
  file_tex_prefix,
  which = c("estimate", "worst", "observed"),
  drop_parametric = TRUE,
  digits = 2
) {
  stopifnot(inherits(model, "gam"))

  which <- match.arg(which)
  cv <- mgcv::concurvity(model, full = FALSE)
  Cmat <- cv[[which]]

  if (drop_parametric) {
    keep <- grepl("^s\\(", rownames(Cmat))
    Cmat <- Cmat[keep, keep, drop = FALSE]
  }

  diag(Cmat) <- NA_real_

  # Clean names
  rn <- gsub("^s\\((.*)\\)$", "\\1", rownames(Cmat))
  cn <- gsub("^s\\((.*)\\)$", "\\1", colnames(Cmat))
  rownames(Cmat) <- rn
  colnames(Cmat) <- cn

  # Round + blank NA
  Cmat <- round(Cmat, digits)
  Cmat[is.na(Cmat)] <- ""

  # ---- DEFINE GROUPS ----
  groups <- list(
    cat = grep("^.*:cat", cn, value = TRUE),
    
    position = grep("^.*:(word|morph|syl)", cn, value = TRUE),
    
    bigram = grep("^bigram", cn, value = TRUE),
    
    linepos = grep("^.*:(end_position|start_position)", cn, value = TRUE)
  )

  # ---- EXPORT EACH GROUP ----
  for (gname in names(groups)) {
    cols <- groups[[gname]]
    
    if (length(cols) == 0) next

    submat <- Cmat[, cols, drop = FALSE]
    df <- as.data.frame(submat)

    tab <- knitr::kable(
      df,
      format = "latex",
      booktabs = TRUE,
      caption = paste("Pairwise concurvity (", which, ") — ", gname, sep = "")
    )

    file_out <- paste0(file_tex_prefix, "_", gname, ".tex")
    writeLines(tab, file_out)
  }

  invisible(Cmat)
}


export_concurvity_latex <- function(
  model,
  file_tex,
  which = c("estimate", "worst", "observed"),
  drop_parametric = TRUE,
  digits = 2
) {
  stopifnot(inherits(model, "gam"))

  which <- match.arg(which)
  cv <- mgcv::concurvity(model, full = FALSE)

  if (!which %in% names(cv)) {
    stop("Requested concurvity matrix not found: ", which)
  }

  Cmat <- cv[[which]]

  # Keep only smooth terms if requested
  if (drop_parametric) {
    keep <- grepl("^s\\(", rownames(Cmat))
    Cmat <- Cmat[keep, keep, drop = FALSE]
  }

  # Remove diagonal
  diag(Cmat) <- NA_real_

  # Clean names (optional but nicer in LaTeX)
  rownames(Cmat) <- gsub("^s\\((.*)\\)$", "\\1", rownames(Cmat))
  colnames(Cmat) <- gsub("^s\\((.*)\\)$", "\\1", colnames(Cmat))

  # Round values
  Cmat_round <- round(Cmat, digits)

  # Replace NA with empty string
  Cmat_round[is.na(Cmat_round)] <- ""

  # Convert to data frame (important for kable)
  df <- as.data.frame(Cmat_round)

  # Create LaTeX table
  tab <- knitr::kable(
    df,
    format = "latex",
    booktabs = TRUE,
    caption = paste("Pairwise concurvity (", which, ")", sep = "")
  )

  # Write to file
  writeLines(tab, file_tex)

  invisible(Cmat)
}

plot_differences_unified <- function(model, data, focal, file_prefix, n = 200) {
  
  stopifnot(inherits(model, "gam"))
  
  if (!focal %in% names(data)) {
    stop(paste("Column", focal, "not found in data"))
  }
  
  # Detect type
  is_bool <- is.numeric(data[[focal]]) && all(unique(data[[focal]]) %in% c(0,1))
  is_factor <- is.factor(data[[focal]])
  
  # Levels / contrasts
  if (is_factor) {
    levs <- levels(data[[focal]])
    combs <- combn(levs, 2, simplify = FALSE)
  } else if (is_bool) {
    levs <- c(0,1)
    combs <- list(c(1,0))  # only one meaningful difference
  } else {
    stop("focal variable must be a factor or a 0/1 numeric boolean")
  }
  
  # Base row for other predictors
  base_vals <- lapply(data, function(x) {
    if (is.factor(x)) levels(x)[1]
    else if (is.numeric(x)) mean(x, na.rm = TRUE)
    else x[1]
  })
  
  # Time grid
  t_seq <- seq(min(data$norm_t), max(data$norm_t), length.out = n)
  
  # Loop over contrasts
  for (pair in combs) {
    
    lev1 <- pair[1]
    lev2 <- pair[2]
    
    # Prepare newdata for predictions
    nd1 <- as.data.frame(base_vals)[rep(1, n), ]
    nd1$norm_t <- t_seq
    nd2 <- nd1
    
    if (is_factor) {
      nd1[[focal]] <- factor(lev1, levels = levs)
      nd2[[focal]] <- factor(lev2, levels = levs)
      contrast_label <- paste(lev1, "vs", lev2)
    } else {
      nd1[[focal]] <- lev1
      nd2[[focal]] <- lev2
      contrast_label <- paste(focal, "1 - 0")
    }
    
    # Predict
    p1 <- predict(model, nd1, type = "link", se.fit = TRUE)
    p2 <- predict(model, nd2, type = "link", se.fit = TRUE)
    
    diff_fit <- p1$fit - p2$fit
    diff_se  <- sqrt(p1$se.fit^2 + p2$se.fit^2)
    
    df_plot <- data.frame(
      norm_t = t_seq,
      diff   = diff_fit,
      se     = diff_se
    )
    
    # Plot
    svg(paste0(file_prefix, "_", contrast_label, ".svg"), width = 8, height = 5)
    
    plot(
      df_plot$norm_t, df_plot$diff,
      type = "l",
      ylim = range(df_plot$diff + 2*df_plot$se,
                   df_plot$diff - 2*df_plot$se),
      main = contrast_label,
      xlab = "Normalized time",
      ylab = "Difference in fitted value"
    )
    lines(df_plot$norm_t, df_plot$diff + 2*df_plot$se, lty = 2)
    lines(df_plot$norm_t, df_plot$diff - 2*df_plot$se, lty = 2)
    abline(h = 0, col = "red")
    
    dev.off()
  }
}


plot_cat_smooths <- function(model, data, file, n = 200) {
  
  # Base values
  base_vals <- lapply(data, function(x) {
    if (is.factor(x)) levels(x)[1]
    else if (is.numeric(x)) mean(x, na.rm = TRUE)
    else x[1]
  })
  
  t_seq <- seq(min(data$norm_t), max(data$norm_t), length.out = n)
  levs <- levels(data$cat)
  
  fits <- matrix(NA, nrow = n, ncol = length(levs))
  ses  <- matrix(NA, nrow = n, ncol = length(levs))
  
  for (i in seq_along(levs)) {
    
    lev <- levs[i]
    
    nd <- as.data.frame(base_vals)[rep(1, n), ]
    nd$norm_t <- t_seq
    nd$cat <- factor(lev, levels = levs)
    
    pred <- predict(model, nd, type = "terms", se.fit = TRUE)
    
    term_name <- paste0("s(norm_t):cat", lev)
    
    fits[, i] <- pred$fit[, term_name]
    ses[, i]  <- pred$se.fit[, term_name]
  }
  
  # Plot
  svg(file, width = 8, height = 5)
  
  matplot(
    t_seq, fits,
    type = "l",
    lty = 1,
    col = 1:ncol(fits),
    xlab = "Normalized time",
    ylab = "Smooth effect",
    main = "cat smooths"
  )
  
  legend(
    "topright",
    legend = levs,
    col = 1:length(levs),
    lty = 1,
    bty = "n"
  )
  
  abline(h = 0, col = "red")
  
  dev.off()
}

